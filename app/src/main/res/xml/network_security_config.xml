<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is allowed ONLY for the known LAN / Tailscale hosts the
     COSMOS trial talks to; every other destination must be HTTPS. If the
     server moves to a new address, add that host here — otherwise the app
     fails with "Cleartext HTTP traffic not permitted" (which is the config
     doing its job, not a bug). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- LAN trial server (the app's default base URL). -->
        <domain includeSubdomains="false">192.168.1.107</domain>
        <!-- Local development. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Tailscale MagicDNS names (traffic is WireGuard-encrypted on the
             wire even when the HTTP layer is cleartext). -->
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
